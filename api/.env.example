PORT=3000
APP_ENV=development
# Browser origins allowed to call the API, comma-separated. Literal origins only: any "*" is
# refused at startup, because responses carry the admin's session cookie.
CORS_ORIGINS=http://localhost:5173
# The header your proxy writes the client address into, e.g. X-Forwarded-For. Leave empty when
# there is no proxy.
PROXY_HEADER=
# IPs or CIDR ranges of your proxies, e.g. 10.0.0.0/8. PROXY_HEADER is trusted only from these.
# If this is empty, the header is ignored.
TRUSTED_PROXIES=

DB_HOST=localhost
# The docker-compose host port. Use 5432 for your own local Postgres.
DB_PORT=5436
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=landing
DB_SSLMODE=disable

# How new leads are announced: "log" (default), or "ses" or "resend" for real email. Production
# refuses "log".
NOTIFY_DRIVER=log
# With NOTIFY_DRIVER=ses or resend: the owner's inbox.
NOTIFY_TO=
# With NOTIFY_DRIVER=ses: a verified SES sender address. Never the visitor's address.
SES_FROM=
AWS_REGION=
# Leave both empty to use the machine's AWS role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional subject prefix, e.g. "[My Site]". Usually the `name` in site.config.ts.
NOTIFY_SITE_NAME=
# With NOTIFY_DRIVER=resend: an API key from resend.com.
RESEND_API_KEY=
# With NOTIFY_DRIVER=resend: the sender. The default only delivers to your own Resend account's
# address, which is all a portfolio needs.
RESEND_FROM=onboarding@resend.dev

# A Vercel deploy hook. Content edits call it so the site rebuilds. Empty turns publishing off.
# It is a secret: anyone with it can trigger builds.
VERCEL_DEPLOY_HOOK_URL=
# Seconds to wait after the last edit before calling the hook, so a burst of saves is one deploy.
PUBLISH_DEBOUNCE_SECONDS=30

# Signs admin login tokens. Development uses a built-in default; every other APP_ENV needs at
# least 32 characters. Generate one with `openssl rand -base64 32`.
JWT_SECRET=
# Access token lifetime in minutes. The refresh cookie expires after this many unused days.
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
# The longest a login can last, however active. After this, the admin signs in again.
JWT_SESSION_MAX_DAYS=30
